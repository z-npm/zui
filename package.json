{
  "name": "@o.z/zui",
  "version": "0.9.1",
  "description": "Next-generation Web Component framework leveraging TypeScript Stage 3 standard decorators.",
  "homepage": "https://github.com/z-npm/zui#readme",
  "docs": "https://github.com/z-npm/zui#readme",
  "bugs": {
    "url": "https://github.com/z-npm/zui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z-npm/zui.git"
  },
  "author": {
    "name": "Zero Red",
    "email": "github@zero-red.dev",
    "url": "https://github.com/zero-red-dev"
  },
  "maintainers": [
    {
      "name": "Zero Red",
      "email": "github@zero-red.dev",
      "url": "https://github.com/zero-red-dev"
    }
  ],
  "license": "GPL-3.0-only",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/zero-red-dev"
  },
  "social": {
    "tiktok": "@zero.red.dev",
    "github": "zero-red-dev"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "typescript",
    "decorators",
    "stage-3-decorators",
    "reactive",
    "shadow-dom",
    "dom-abstraction",
    "frontend",
    "framework",
    "boilerplate-free",
    "typed-html",
    "customized-built-in"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && yarn docs",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@o.z/vite-plugin-swc": "^0.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "glob": "^13.0.6",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "sass": "^1.99.0",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.2"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./decorators/types": {
      "types": "./dist/decorators/types.d.ts",
      "import": "./dist/decorators/types.js",
      "require": "./dist/decorators/types.cjs"
    },
    "./decorators/state": {
      "types": "./dist/decorators/state.d.ts",
      "import": "./dist/decorators/state.js",
      "require": "./dist/decorators/state.cjs"
    },
    "./decorators/refs": {
      "types": "./dist/decorators/refs.d.ts",
      "import": "./dist/decorators/refs.js",
      "require": "./dist/decorators/refs.cjs"
    },
    "./decorators/property": {
      "types": "./dist/decorators/property.d.ts",
      "import": "./dist/decorators/property.js",
      "require": "./dist/decorators/property.cjs"
    },
    "./decorators/mixin": {
      "types": "./dist/decorators/mixin.d.ts",
      "import": "./dist/decorators/mixin.js",
      "require": "./dist/decorators/mixin.cjs"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "import": "./dist/decorators/index.js",
      "require": "./dist/decorators/index.cjs"
    },
    "./decorators/fetch": {
      "types": "./dist/decorators/fetch.d.ts",
      "import": "./dist/decorators/fetch.js",
      "require": "./dist/decorators/fetch.cjs"
    },
    "./decorators/event": {
      "types": "./dist/decorators/event.d.ts",
      "import": "./dist/decorators/event.js",
      "require": "./dist/decorators/event.cjs"
    },
    "./decorators/defineElement": {
      "types": "./dist/decorators/defineElement.d.ts",
      "import": "./dist/decorators/defineElement.js",
      "require": "./dist/decorators/defineElement.cjs"
    },
    "./styles/theme.css": {
      "import": "./dist/styles/theme.css",
      "require": "./dist/styles/theme.css"
    },
    "./styles/style.css": {
      "import": "./dist/styles/style.css",
      "require": "./dist/styles/style.css"
    },
    "./styles/reset.css": {
      "import": "./dist/styles/reset.css",
      "require": "./dist/styles/reset.css"
    },
    "./styles/default.css": {
      "import": "./dist/styles/default.css",
      "require": "./dist/styles/default.css"
    }
  },
  "dependencies": {
    "@o.z/utils": "^0.5.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "yarn@4.13.0"
}
