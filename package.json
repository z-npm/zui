{
  "name": "@o.z/zui",
  "version": "0.4.5",
  "description": "Next-generation Web Component framework leveraging TypeScript Stage 3 standard decorators.",
  "homepage": "https://github.com/z-npm/zui#readme",
  "docs": "https://github.com/z-npm/zui#readme",
  "bugs": {
    "url": "https://github.com/z-npm/zui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z-npm/zui.git"
  },
  "author": {
    "name": "Zero Red",
    "email": "github@zero-red.dev",
    "url": "https://github.com/zero-red-dev"
  },
  "maintainers": [
    {
      "name": "Zero Red",
      "email": "github@zero-red.dev",
      "url": "https://github.com/zero-red-dev"
    }
  ],
  "license": "GPL-3.0-only",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/zero-red-dev"
  },
  "social": {
    "tiktok": "@zero.red.dev",
    "github": "zero-red-dev"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "typescript",
    "decorators",
    "stage-3-decorators",
    "reactive",
    "shadow-dom",
    "dom-abstraction",
    "frontend",
    "framework",
    "boilerplate-free",
    "typed-html",
    "customized-built-in"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && yarn docs",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.1.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@z-code/vite-plugin-swc": "^0.5.5",
    "glob": "^13.0.0",
    "globals": "^17.3.0",
    "jsdom": "^27.4.0",
    "sass": "^1.97.3",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.0.18"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    "./utilities": {
      "types": "./dist/utilities.d.ts",
      "import": "./dist/utilities.js",
      "require": "./dist/utilities.cjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js",
      "require": "./dist/html.cjs"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs"
    },
    "./decorators/types": {
      "types": "./dist/decorators/types.d.ts",
      "import": "./dist/decorators/types.js",
      "require": "./dist/decorators/types.cjs"
    },
    "./decorators/state": {
      "types": "./dist/decorators/state.d.ts",
      "import": "./dist/decorators/state.js",
      "require": "./dist/decorators/state.cjs"
    },
    "./decorators/refs": {
      "types": "./dist/decorators/refs.d.ts",
      "import": "./dist/decorators/refs.js",
      "require": "./dist/decorators/refs.cjs"
    },
    "./decorators/property": {
      "types": "./dist/decorators/property.d.ts",
      "import": "./dist/decorators/property.js",
      "require": "./dist/decorators/property.cjs"
    },
    "./decorators/mixin": {
      "types": "./dist/decorators/mixin.d.ts",
      "import": "./dist/decorators/mixin.js",
      "require": "./dist/decorators/mixin.cjs"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "import": "./dist/decorators/index.js",
      "require": "./dist/decorators/index.cjs"
    },
    "./decorators/event": {
      "types": "./dist/decorators/event.d.ts",
      "import": "./dist/decorators/event.js",
      "require": "./dist/decorators/event.cjs"
    },
    "./decorators/defineElement": {
      "types": "./dist/decorators/defineElement.d.ts",
      "import": "./dist/decorators/defineElement.js",
      "require": "./dist/decorators/defineElement.cjs"
    }
  },
  "dependencies": {
    "csstype": "^3.2.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "yarn@4.12.0"
}
